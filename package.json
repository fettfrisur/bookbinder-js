{
  "name": "bookbinder",
  "version": "1.6.1",
  "description": "An app to rearrange PDF pages for printing for bookbinding",
  "type": "module",
  "scripts": {
    "cli": "bun cli.js",
    "bundle": "bun build cli.js --outfile bookbinder.js --target=bun",
    "test": "vitest --run --pool=forks",
    "test:unit": "vitest --run src",
    "test:pdf": "vitest --run --pool=forks pdf-test",
    "generate-snapshots": "bun ./pdf-test/generateSnapshots.js",
    "lint": "bunx eslint src cli.js",
    "lint:fix": "bunx eslint src cli.js --fix",
    "prettier": "bunx prettier --check .",
    "prettier:fix": "bunx prettier --write ."
  },
  "author": "momijizukamori@gmail.com",
  "license": "MPL",
  "devDependencies": {
    "eslint": "^8.56.0",
    "pdf-visual-diff": "^0.14.0",
    "prettier": "^3.2.5",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^1.21.0",
    "zod": "^3.22.4"
  }
}
